{
  "name": "dark-hubb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npx --yes prisma@7 generate",
    "db:generate": "npx --yes prisma@7 generate",
    "db:migrate": "npx --yes prisma@7 migrate dev",
    "db:migrate:prod": "npx --yes prisma@7 migrate deploy",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "db:studio": "npx --yes prisma@7 studio",
    "db:reset": "npx --yes prisma@7 migrate reset",
    "telegram:test": "node --env-file=.env.local scripts/telegram-test.mjs",
    "verify:backend": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/verify-backend.mts",
    "verify:pipeline": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/verify-pipeline.mts",
    "video:moderate": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/moderate-video.mts",
    "thumb:backfill": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/backfill-thumbnail.mts",
    "cache:warm": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/warm-cache.mts",
    "demo:seed": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/seed-demo.mts",
    "demo:clear": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/clear-demo.mts",
    "upload:local": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/upload-local.mts",
    "worker:staging": "tsx --env-file=.env.local --import ./scripts/preload.mjs scripts/staging-worker.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "hls.js": "^1.7.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "prisma": "^8.0.0-rc.13",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx --env-file=.env.local prisma/seed.ts"
  }
}
